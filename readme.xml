&lt;!-- ════════════════════════════════════════
     res/drawable/bg_glow_circle.xml
     Lingkaran glow ungu untuk background blob
════════════════════════════════════════ --&gt;

&lt;!-- File 1: res/drawable/bg_glow_circle.xml --&gt;
&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval"&gt;
    &lt;solid android:color="#7C3AED"/&gt;
&lt;/shape&gt;


&lt;!-- ════════════════════════════════════════
     File 2: res/drawable/ring_outer.xml
     Ring terluar logo (border ungu transparan)
════════════════════════════════════════ --&gt;
&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval"&gt;
    &lt;stroke
        android:width="1.5dp"
        android:color="#4D7C3AED"/&gt;  &lt;!-- #4D = 30% opacity --&gt;
    &lt;solid android:color="@android:color/transparent"/&gt;
&lt;/shape&gt;


&lt;!-- ════════════════════════════════════════
     File 3: res/drawable/ring_inner.xml
     Ring dalam logo (border lebih terang)
════════════════════════════════════════ --&gt;
&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval"&gt;
    &lt;stroke
        android:width="1dp"
        android:color="#338B5CF6"/&gt;  &lt;!-- #33 = 20% opacity --&gt;
    &lt;solid android:color="@android:color/transparent"/&gt;
&lt;/shape&gt;


&lt;!-- ════════════════════════════════════════
     File 4: res/drawable/bg_progress_track.xml
     Background track loading bar
════════════════════════════════════════ --&gt;
&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"&gt;
    &lt;solid android:color="#1AFFFFFF"/&gt;  &lt;!-- putih 10% --&gt;
    &lt;corners android:radius="4dp"/&gt;
&lt;/shape&gt;


&lt;!-- ════════════════════════════════════════
     File 5: res/drawable/bg_progress_fill.xml
     Fill loading bar (gradient ungu)
════════════════════════════════════════ --&gt;
&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"&gt;
    &lt;gradient
        android:startColor="#7C3AED"
        android:endColor="#A78BFA"
        android:angle="0"/&gt;
    &lt;corners android:radius="4dp"/&gt;
&lt;/shape&gt;


&lt;!-- ════════════════════════════════════════
     File 6: res/values/colors.xml (tambahan)
     Warna baru untuk splash
════════════════════════════════════════ --&gt;
&lt;!-- Tambahkan ke colors.xml yang sudah ada: --&gt;
&lt;color name="splash_bg"&gt;#0F0A1E&lt;/color&gt;
&lt;color name="splash_purple"&gt;#7C3AED&lt;/color&gt;
&lt;color name="splash_purple_light"&gt;#A78BFA&lt;/color&gt;
